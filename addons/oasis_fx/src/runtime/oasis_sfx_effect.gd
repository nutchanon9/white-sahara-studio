class_name OasisSfxEffect
extends Node2D
## Plays a layered sound generated by OasisFx: starts each layer at its
## offset, picks a variant, applies random pitch/volume, trims, fades and
## loops, then frees the sound (only the sound itself) when every layer has
## ended. Works with AudioStreamPlayer and AudioStreamPlayer2D children.
##
## Timing uses this script's own clock and each stream's length, so it does
## not depend on the audio driver (it behaves the same with the Dummy driver
## used in headless tests). Not a @tool script: nothing plays in the editor.
##
##   OasisSfxEffect.spawn(preload("res://sfx/sword_slash_sfx.tscn"), self, hit_position)

## Emitted once when a sound without looping layers has completely finished.
signal finished

const SILENT_DB := -80.0

@export var effect_id: String = ""
## Random pitch change per play for the whole sound, ± percent.
@export var random_pitch_percent: float = 0.0
## -1 = unpredictable choices; >= 0 = the same sequence of choices in every
## run (each play still differs from the previous one).
@export var random_seed: int = -1
@export var auto_play: bool = true
## queue_free() after `finished`. Sounds with looping layers are never freed automatically.
@export var free_when_finished: bool = true
## Layer node name -> {start_ms, trim_start_ms, length_ms, fade_in_ms,
## fade_out_ms, random_pitch_percent, random_volume_db, loop, variants}.
@export var layer_settings: Dictionary = {}

var _rng := RandomNumberGenerator.new()
var _rng_ready := false
var _elapsed := 0.0
var _playing := false
var _paused := false
var _base := {}
var _state := {}
var _last_choice := {}


func _ready() -> void:
	set_process(false)
	if Engine.is_editor_hint():
		return
	if auto_play:
		play()


static func spawn(scene: PackedScene, parent: Node, global_pos := Vector2.ZERO) -> OasisSfxEffect:
	var effect := scene.instantiate() as OasisSfxEffect
	if effect == null:
		push_error("OasisSfxEffect.spawn: %s is not an OasisFx sound scene" % scene.resource_path)
		return null
	parent.add_child(effect)
	effect.global_position = global_pos
	return effect


## Starts (or restarts) the sound from the beginning.
func play() -> void:
	_capture_base()
	for player in get_players():
		player.stop()
	if not _rng_ready:
		_rng_ready = true
		if random_seed >= 0:
			_rng.seed = random_seed
		else:
			_rng.randomize()
	var effect_pitch := _random_factor(random_pitch_percent)
	_state.clear()
	for player in get_players():
		_state[String(player.name)] = {"started": false, "first": true, "done": false, "effect_pitch": effect_pitch}
	_elapsed = 0.0
	_playing = true
	_paused = false
	set_process(true)
	_advance(0.0)


func restart() -> void:
	play()


## Stops every layer immediately. Does not emit `finished` or free.
func stop() -> void:
	_playing = false
	_paused = false
	set_process(false)
	for player in get_players():
		player.stop()
		player.stream_paused = false


func set_paused(paused: bool) -> void:
	_paused = paused
	for player in get_players():
		player.stream_paused = paused
	set_process(_playing and not _paused)


func is_paused() -> bool:
	return _paused


func is_playing() -> bool:
	return _playing


func get_elapsed() -> float:
	return _elapsed


## True when at least one layer loops (the sound never finishes by itself).
func is_looping() -> bool:
	for id in layer_settings:
		if layer_settings[id].get("loop", false):
			return true
	return false


## Seconds from play() until the last non-looping layer ends, using the
## longest of each layer's variants and ignoring random pitch.
func get_total_time() -> float:
	_capture_base()
	var end := 0.0
	for player in get_players():
		var s := _settings(player)
		var longest := 0.0
		for stream in _choices(player):
			longest = maxf(longest, _layer_duration(stream, s, _base[String(player.name)].pitch))
		end = maxf(end, s.get("start_ms", 0.0) / 1000.0 + longest)
	return end


func get_players() -> Array[Node]:
	var out: Array[Node] = []
	for child in get_children():
		if child is AudioStreamPlayer or child is AudioStreamPlayer2D:
			out.append(child)
	return out


## Stream chosen for each layer in the current play: layer name -> AudioStream.
func get_current_streams() -> Dictionary:
	var out := {}
	for player in get_players():
		out[String(player.name)] = player.stream
	return out


func _process(delta: float) -> void:
	_advance(delta)


func _advance(dt: float) -> void:
	if not _playing:
		return
	_elapsed += dt
	for player in get_players():
		var key := String(player.name)
		var st: Dictionary = _state[key]
		var s := _settings(player)
		if st.done:
			continue
		if not st.started:
			if _elapsed * 1000.0 >= s.get("start_ms", 0.0):
				_start_layer(player, st, s)
			continue
		var t: float = _elapsed - st.start_time
		if t >= st.duration:
			if s.get("loop", false) and st.duration > 0.0:
				_start_layer(player, st, s, st.start_time + st.duration)
				t = _elapsed - st.start_time
			else:
				player.stop()
				st.done = true
				continue
		player.volume_db = st.volume + linear_to_db(maxf(_fade_gain(t, st.duration, s, st.first), 0.0001))
	for key in _state:
		if not _state[key].done:
			return
	_finish()


func _start_layer(player: Node, st: Dictionary, s: Dictionary, at := -1.0) -> void:
	var key := String(player.name)
	var stream := _pick(player)
	player.stream = stream
	var pitch: float = _base[key].pitch * st.effect_pitch * _random_factor(s.get("random_pitch_percent", 0.0))
	player.pitch_scale = pitch
	var rv: float = s.get("random_volume_db", 0.0)
	st.volume = _base[key].volume + (_rng.randf_range(-rv, rv) if rv > 0.0 else 0.0)
	st.duration = _layer_duration(stream, s, pitch)
	st.start_time = _elapsed if at < 0.0 else at
	st.first = not st.started
	st.started = true
	player.volume_db = st.volume + linear_to_db(maxf(_fade_gain(0.0, st.duration, s, st.first), 0.0001))
	player.play(s.get("trim_start_ms", 0.0) / 1000.0)
	if _paused:
		player.stream_paused = true


## Seconds of real time a layer plays with `stream` at `pitch`.
static func _layer_duration(stream: AudioStream, s: Dictionary, pitch: float) -> float:
	var file_len := stream.get_length() if stream != null else 0.0
	var available := maxf(0.0, file_len - s.get("trim_start_ms", 0.0) / 1000.0)
	var length_ms: float = s.get("length_ms", 0.0)
	if length_ms > 0.0:
		available = minf(available, length_ms / 1000.0) if file_len > 0.0 else length_ms / 1000.0
	return available / maxf(pitch, 0.01)


## Linear gain 0..1 from fade-in and fade-out at time t of a layer lasting
## `duration`. The fade-in applies only to the first play of a layer (`first`),
## so a looping layer fades in once and then repeats at full volume.
static func _fade_gain(t: float, duration: float, s: Dictionary, first := true) -> float:
	var gain := 1.0
	var fade_in: float = s.get("fade_in_ms", 0.0) / 1000.0 if first else 0.0
	var fade_out: float = s.get("fade_out_ms", 0.0) / 1000.0
	if fade_in > 0.0:
		gain = minf(gain, t / fade_in)
	if fade_out > 0.0:
		gain = minf(gain, (duration - t) / fade_out)
	return clampf(gain, 0.0, 1.0)


func _pick(player: Node) -> AudioStream:
	var choices := _choices(player)
	var key := String(player.name)
	if choices.size() == 1:
		return choices[0]
	var index := _rng.randi_range(0, choices.size() - 1)
	if _last_choice.has(key) and index == _last_choice[key]:
		index = (index + 1 + _rng.randi_range(0, choices.size() - 2)) % choices.size()
	_last_choice[key] = index
	return choices[index]


func _choices(player: Node) -> Array:
	var key := String(player.name)
	var choices: Array = [_base[key].stream]
	for v in _settings(player).get("variants", []):
		if v is AudioStream:
			choices.append(v)
	return choices


func _settings(player: Node) -> Dictionary:
	return layer_settings.get(String(player.name), {})


func _random_factor(percent: float) -> float:
	if percent <= 0.0:
		return 1.0
	return 1.0 + _rng.randf_range(-percent, percent) / 100.0


# The scene's own stream/volume/pitch per player are the base values every
# play starts from (players are modified while playing).
func _capture_base() -> void:
	for player in get_players():
		var key := String(player.name)
		if not _base.has(key):
			_base[key] = {"stream": player.stream, "volume": player.volume_db, "pitch": player.pitch_scale}


func _finish() -> void:
	_playing = false
	set_process(false)
	finished.emit()
	if free_when_finished and not Engine.is_editor_hint():
		queue_free()
