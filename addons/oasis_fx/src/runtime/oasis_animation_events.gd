class_name OasisAnimationEvents
extends Node
## Receives the events of animations generated by OasisFx and shows their
## effects and sounds. Add one node named "OasisAnimationEvents" with this
## script as a child of the animated scene's root (the AnimationPlayer's root
## node); the generated animations call oasis_event() on it.
##
## Events are cosmetic: they show OasisFx effects/sounds and emit
## `event_triggered` so game code can react (footstep sounds, camera shake …).
## They never decide damage, items or timing; keep gameplay in game code.
##
##   $OasisAnimationEvents.event_triggered.connect(func(name, _at): if name == &"hit_frame": ...)

const _ALLOWED_RUNTIMES := [
	"res://addons/oasis_fx/src/runtime/oasis_fx_effect.gd",
	"res://addons/oasis_fx/src/runtime/oasis_sfx_effect.gd",
]
## The same runtimes by class name, so they are recognised when the addon
## folder was moved in the game (UIDs keep the scenes working).
const _ALLOWED_CLASSES := [&"OasisFxEffect", &"OasisSfxEffect"]

## Emitted for every event, before its effects appear. `at` is the node the
## event names (null when it does not exist).
signal event_triggered(event_name: StringName, at: Node)

## false = only emit event_triggered (e.g. on a headless server).
@export var show_effects: bool = true
## Where effects are added. Empty = the parent of the animated scene's root, so
## a hit spark stays where it appeared when the character moves on.
@export var effects_parent: NodePath


## Called by animation method tracks. Only scenes generated by OasisFx are shown.
func oasis_event(event_name: StringName, effects: Array, at: NodePath) -> void:
	var root := get_parent()
	var at_node: Node = root.get_node_or_null(at) if root != null else null
	event_triggered.emit(event_name, at_node)
	if not show_effects or effects.is_empty() or root == null:
		return
	var parent := get_node_or_null(effects_parent) if not effects_parent.is_empty() else root.get_parent()
	if parent == null:
		parent = root
	for scene in effects:
		if not scene is PackedScene:
			continue
		var effect: Node = scene.instantiate()
		if effect == null:
			push_warning("OasisAnimationEvents: %s could not be instantiated (missing files?); not shown" % scene.resource_path)
			continue
		var script: Script = effect.get_script()
		if script == null or not (_ALLOWED_RUNTIMES.has(script.resource_path) or _ALLOWED_CLASSES.has(script.get_global_name())):
			push_warning("OasisAnimationEvents: %s is not an OasisFx effect or sound; not shown" % scene.resource_path)
			effect.free()
			continue
		parent.add_child(effect)
		if effect is Node2D and at_node is Node2D:
			effect.global_position = at_node.global_position
