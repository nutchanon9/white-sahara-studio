class_name OasisFxEffect
extends Node2D
## Plays a scene generated by OasisFx: starts each emitter after its delay,
## stops continuous emitters at the end of the effect, repeats looping effects
## and frees the effect (only the effect itself, never its parent) when the
## last particle is gone.
##
## Uses only GPUParticles2D children; nothing here depends on the OasisFx
## desktop app or the CLI. Not a @tool script: when a generated scene is opened
## in the Godot editor nothing plays and nothing is freed.
##
##   var fx := OasisFxEffect.spawn(preload("res://vfx/fire_burst.tscn"), self, hit_position)
##   fx.finished.connect(_on_fx_done)

## Emitted once when a non-looping effect has completely finished (before it
## is freed when free_when_finished is true). Never emitted by looping effects.
signal finished

@export var effect_id: String = ""
## Length of one effect cycle in seconds (effect time, see playback_speed).
@export var duration_seconds: float = 1.0
@export var loop: bool = false
## Multiplies effect time and every emitter's speed_scale (also when changed
## while playing, e.g. right after spawn()).
@export var playback_speed: float = 1.0:
	set(value):
		playback_speed = value
		if is_inside_tree():
			_apply_speed()
## Start playing when the effect enters the scene tree.
@export var auto_play: bool = true
## queue_free() this effect after finished. Looping effects are never freed automatically.
@export var free_when_finished: bool = true
## Emitter node name -> start delay in seconds within a cycle.
@export var emitter_delays: Dictionary = {}

var _elapsed := 0.0
var _playing := false
var _paused := false
var _emission_closed := false
var _started := {}
var _ever_started := {}
var _finish_time := 0.0


func _ready() -> void:
	set_process(false)
	if Engine.is_editor_hint():
		return
	for emitter in get_emitters():
		emitter.emitting = false
	if auto_play:
		play()


## Instantiates `scene` under `parent` at `global_pos` and returns it (it starts
## playing automatically unless the scene's auto_play is off).
static func spawn(scene: PackedScene, parent: Node, global_pos: Vector2) -> OasisFxEffect:
	var effect := scene.instantiate() as OasisFxEffect
	if effect == null:
		push_error("OasisFxEffect.spawn: %s is not an OasisFx effect scene" % scene.resource_path)
		return null
	parent.add_child(effect)
	effect.global_position = global_pos
	return effect


## Starts (or restarts) the effect from the beginning.
func play() -> void:
	_clear_particles()
	_elapsed = 0.0
	_playing = true
	_paused = false
	_emission_closed = false
	_started.clear()
	_ever_started.clear()
	_finish_time = _compute_finish_time()
	_apply_speed()
	set_process(true)
	_advance(0.0)


## Same as play(): clears current particles and starts over.
func restart() -> void:
	play()


## Stops immediately and removes all particles. Does not emit `finished` or free.
func stop() -> void:
	_playing = false
	_paused = false
	set_process(false)
	_clear_particles()
	_apply_speed()


## Freezes (true) or resumes (false) the effect, particles included.
func set_paused(paused: bool) -> void:
	_paused = paused
	_apply_speed()
	set_process(_playing and not _paused)


func is_paused() -> bool:
	return _paused


## True from play() until the effect finishes or stop() is called.
func is_playing() -> bool:
	return _playing


## Effect time since play(), within the current cycle for looping effects.
func get_elapsed() -> float:
	return _elapsed


## Effect time from play() until a non-looping effect finishes.
func get_total_time() -> float:
	return _compute_finish_time()


func get_emitters() -> Array[GPUParticles2D]:
	var out: Array[GPUParticles2D] = []
	for child in get_children():
		if child is GPUParticles2D:
			out.append(child)
	return out


func _process(delta: float) -> void:
	_advance(delta * playback_speed)


func _advance(dt: float) -> void:
	if not _playing:
		return
	_elapsed += dt
	if loop and _elapsed >= duration_seconds and duration_seconds > 0.0:
		_start_due_emitters()
		_elapsed = fmod(_elapsed, duration_seconds)
		# One-shot emitters fire again each cycle; continuous ones keep running.
		for emitter in get_emitters():
			if emitter.one_shot:
				_started.erase(String(emitter.name))
	_start_due_emitters()
	if loop:
		return
	if not _emission_closed and _elapsed >= duration_seconds:
		_emission_closed = true
		for emitter in get_emitters():
			if not emitter.one_shot:
				emitter.emitting = false
	if _elapsed >= _finish_time:
		_finish()


func _start_due_emitters() -> void:
	if _emission_closed:
		return
	for emitter in get_emitters():
		var key := String(emitter.name)
		if _started.has(key) or _elapsed < float(emitter_delays.get(key, 0.0)):
			continue
		_started[key] = true
		if not _ever_started.has(key):
			_ever_started[key] = true
			emitter.restart()
		elif not emitter.emitting:
			# A finished one-shot cycle: start the next one without clearing.
			emitter.emitting = true


func _finish() -> void:
	_playing = false
	set_process(false)
	finished.emit()
	if free_when_finished and not Engine.is_editor_hint():
		queue_free()


func _compute_finish_time() -> float:
	var end := duration_seconds
	for emitter in get_emitters():
		var delay := float(emitter_delays.get(String(emitter.name), 0.0))
		if emitter.one_shot:
			# Emission is spread over (1 - explosiveness) * lifetime; the last
			# particle then lives one more lifetime.
			end = maxf(end, delay + emitter.lifetime * (2.0 - emitter.explosiveness))
		else:
			end = maxf(end, duration_seconds + emitter.lifetime)
	return end


func _apply_speed() -> void:
	var speed := 0.0 if _paused else playback_speed
	for emitter in get_emitters():
		emitter.speed_scale = speed


func _clear_particles() -> void:
	for emitter in get_emitters():
		emitter.restart()
		emitter.emitting = false
