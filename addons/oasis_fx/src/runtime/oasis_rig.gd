class_name OasisRig
extends Node2D
## Root script of a 2D cutout rig generated by OasisFx (asset type `rig`):
## switches skins (costume variants), applies named poses and finds bones and
## IK targets by id. The rig itself is plain Godot: Skeleton2D / Bone2D with
## Polygon2D and Sprite2D parts, two-bone IK in the skeleton's modification
## stack, and an AnimationPlayer holding RESET and pose_<name> animations.
## Polygon parts with bone weights (Polygon2D `bones`) are bent by this script
## on the CPU every frame, with the same math as Godot's 2D skinning.
## Not a @tool script: nothing changes when the scene is open in the editor
## (weighted parts show their rest shape there).
##
##   var chef: OasisRig = preload("res://chars/oasis_chef.tscn").instantiate()
##   chef.apply_skin("night_shift")
##   chef.set_pose("wave")
##   chef.get_ik_target("arm_r").global_position = pot.global_position

const SKELETON := "Skeleton"
const IK_TARGETS := "IKTargets"

@export var rig_id: String = ""
## Skin name -> {part node path: {"texture": Texture2D, "color": Color, "visible": bool}}
## (only the changed values). The parts as saved in the scene are skin "".
@export var skins: Dictionary = {}
## Bend weighted parts with Godot's GPU skinning (Polygon2D.skeleton) instead
## of on the CPU. Off by default: in Godot 4.7.2's Compatibility renderer
## (tested with Mesa llvmpipe) GPU skinning drew points weighted to any bone
## but the first one wrongly.
@export var gpu_deform := false

## Name of the skin applied last ("" = as saved).
var current_skin := ""
var _base := {}
## One entry per weighted Polygon2D bent on the CPU.
var _deformers: Array[Dictionary] = []


func _ready() -> void:
	_own_ik_stack()
	_capture_base()
	_setup_deformation()


func _process(_delta: float) -> void:
	update_deformation()


## Bends the weighted parts to the bones' current pose. Runs every frame after
## animations and IK (process_priority 1000); call it yourself after moving
## bones when the rig does not process (e.g. paused).
func update_deformation() -> void:
	var skeleton := get_skeleton()
	if skeleton == null or _deformers.is_empty():
		return
	var to_skeleton := skeleton.global_transform.affine_inverse()
	for d in _deformers:
		var poly: Polygon2D = d.poly
		if not is_instance_valid(poly) or not poly.is_visible_in_tree():
			continue
		# Godot's skinning: points in skeleton space, moved by each bone's
		# (current pose × inverse rest pose), blended by weight.
		var into: Transform2D = to_skeleton * poly.global_transform
		var moves: Array[Transform2D] = [into]
		for i in d.bones.size():
			moves.append(to_skeleton * (d.bones[i] as Bone2D).global_transform * d.rest_inverse[i])
		if moves == d.last:
			continue  # nothing moved since the last frame
		d.last = moves
		var back := into.affine_inverse()
		var rest: PackedVector2Array = d.rest
		var offset := poly.offset
		var first: PackedInt32Array = d.first
		var bone: PackedInt32Array = d.bone
		var weight: PackedFloat32Array = d.weight
		var out := PackedVector2Array()
		out.resize(rest.size())
		for v in rest.size():
			if first[v] == first[v + 1]:
				out[v] = rest[v]  # no weight: stays put
				continue
			var p: Vector2 = into * (rest[v] + offset)
			var sum := Vector2.ZERO
			for k in range(first[v], first[v + 1]):
				sum += moves[bone[k]] * p * weight[k]
			out[v] = back * sum - offset
		poly.polygon = out


func get_skin_names() -> PackedStringArray:
	return PackedStringArray(skins.keys())


## Applies a skin: first resets every part a skin may change to its saved
## look, then applies `skin_name`'s changes. "" restores the saved look.
## Returns false (and changes nothing) for an unknown skin.
func apply_skin(skin_name: String) -> bool:
	if not skin_name.is_empty() and not skins.has(skin_name):
		push_warning("OasisRig %s: no skin \"%s\" (skins: %s)" % [rig_id, skin_name, ", ".join(get_skin_names())])
		return false
	_capture_base()
	for part_path in _base:
		_apply(part_path, _base[part_path])
	if not skin_name.is_empty():
		var changes: Dictionary = skins[skin_name]
		for part_path in changes:
			_apply(part_path, changes[part_path])
	current_skin = skin_name
	return true


func get_pose_names() -> PackedStringArray:
	var out := PackedStringArray()
	var player := get_animation_player()
	if player:
		for anim in player.get_animation_list():
			if anim.begins_with("pose_"):
				out.append(anim.trim_prefix("pose_"))
	return out


## Shows pose `pose_name` ("" = the rest pose) at once. Bones driven by IK
## keep following their targets. Returns false for an unknown pose.
func set_pose(pose_name: String) -> bool:
	var player := get_animation_player()
	var anim := "RESET" if pose_name.is_empty() else "pose_" + pose_name
	if player == null or not player.has_animation(anim):
		push_warning("OasisRig %s: no pose \"%s\"" % [rig_id, pose_name])
		return false
	player.play(anim)
	player.seek(0.0, true)
	player.stop(true)
	return true


func get_animation_player() -> AnimationPlayer:
	return get_node_or_null("AnimationPlayer") as AnimationPlayer


func get_skeleton() -> Skeleton2D:
	return get_node_or_null(SKELETON) as Skeleton2D


## The Bone2D named `bone_id` anywhere in the skeleton, or null.
func get_bone(bone_id: String) -> Bone2D:
	var skeleton := get_skeleton()
	return skeleton.find_child(bone_id, true, false) as Bone2D if skeleton else null


## The Marker2D target of IK chain `chain_id`, or null.
func get_ik_target(chain_id: String) -> Marker2D:
	return get_node_or_null("%s/%s" % [IK_TARGETS, chain_id]) as Marker2D


## Turns all IK chains on or off (off = bones keep their animated rotations).
func set_ik_enabled(enabled: bool) -> void:
	var skeleton := get_skeleton()
	if skeleton and skeleton.get_modification_stack():
		skeleton.get_modification_stack().enabled = enabled


# Finds weighted Polygon2D parts (bones set, no skeleton) and remembers their
# rest points, bones and inverse rest poses.
func _setup_deformation() -> void:
	var skeleton := get_skeleton()
	_deformers.clear()
	if skeleton != null:
		for poly: Polygon2D in find_children("*", "Polygon2D", true, false):
			if poly.get_bone_count() == 0 or not poly.skeleton.is_empty():
				continue
			if gpu_deform:
				poly.skeleton = poly.get_path_to(skeleton)
				continue
			var d := {"poly": poly, "rest": poly.polygon, "bones": [], "weights": [], "rest_inverse": [], "last": []}
			for i in poly.get_bone_count():
				var bone := skeleton.get_node_or_null(poly.get_bone_path(i)) as Bone2D
				var weights := poly.get_bone_weights(i)
				if bone == null or weights.size() != poly.polygon.size():
					push_warning("OasisRig %s: %s: bone %s is missing or its weights do not match the points" % [rig_id, poly.name, poly.get_bone_path(i)])
					continue
				d.bones.append(bone)
				d.weights.append(weights)
				d.rest_inverse.append(bone.get_skeleton_rest().affine_inverse())
			_sparse_weights(d)
			# The texture must stay on the rest points while the outline bends.
			if poly.uv.size() != poly.polygon.size():
				var uv := PackedVector2Array()
				for p in poly.polygon:
					uv.append(p + poly.offset)
				poly.uv = uv
			_deformers.append(d)
	process_priority = 1000
	set_process(not _deformers.is_empty())
	update_deformation()


# Per point, only the bones that pull it, with weights divided by their sum:
# point v uses entries first[v] … first[v + 1] - 1 of `bone` (index into the
# moves of update_deformation(), 1 = the first bone) and `weight`.
static func _sparse_weights(d: Dictionary) -> void:
	var first := PackedInt32Array([0])
	var bone := PackedInt32Array()
	var weight := PackedFloat32Array()
	for v in d.rest.size():
		var total := 0.0
		for i in d.weights.size():
			total += maxf(d.weights[i][v], 0.0)
		for i in d.weights.size():
			if total > 0.0 and d.weights[i][v] > 0.0:
				bone.append(i + 1)
				weight.append(d.weights[i][v] / total)
		first.append(bone.size())
	d.first = first
	d.bone = bone
	d.weight = weight


# All instances of a rig scene share the skeleton's SkeletonModificationStack2D
# resource, but a stack works for one Skeleton2D only. Give this rig its own
# stack with the same two-bone IK settings (rebuilt rather than duplicated:
# duplicating copies unresolved bone indices and logs errors).
func _own_ik_stack() -> void:
	var skeleton := get_skeleton()
	var shared := skeleton.get_modification_stack() if skeleton else null
	if shared == null:
		return
	var stack := SkeletonModificationStack2D.new()
	for i in shared.modification_count:
		var source := shared.get_modification(i) as SkeletonModification2DTwoBoneIK
		if source == null:
			continue
		var ik := SkeletonModification2DTwoBoneIK.new()
		ik.target_nodepath = source.target_nodepath
		ik.set_joint_one_bone2d_node(source.get_joint_one_bone2d_node())
		ik.set_joint_two_bone2d_node(source.get_joint_two_bone2d_node())
		ik.flip_bend_direction = source.flip_bend_direction
		ik.enabled = source.enabled
		stack.add_modification(ik)
	stack.enabled = shared.enabled
	skeleton.set_modification_stack(stack)


func _capture_base() -> void:
	for skin in skins.values():
		for part_path in skin:
			if _base.has(part_path):
				continue
			var part := get_node_or_null(NodePath(part_path))
			if part == null:
				continue
			_base[part_path] = {
				"texture": part.get("texture"),
				"color": part.color if part is Polygon2D else part.self_modulate,
				"visible": part.visible,
			}


func _apply(part_path: String, look: Dictionary) -> void:
	var part := get_node_or_null(NodePath(part_path)) as CanvasItem
	if part == null:
		return
	if look.has("texture") and "texture" in part:
		part.set("texture", look.texture)
	if look.has("color"):
		if part is Polygon2D:
			part.color = look.color
		else:
			part.self_modulate = look.color
	if look.has("visible"):
		part.visible = look.visible
