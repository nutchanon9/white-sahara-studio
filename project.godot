; Development host project for the OasisFx addon.
; The addon itself lives in addons/oasis_fx/ and can be copied into any Godot 4.x project.

config_version=5

[application]

config/name="OasisFx Dev"
config/description="Development and test host project for the OasisFx Godot addon."
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
